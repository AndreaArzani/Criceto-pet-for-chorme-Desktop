{
  "manifest_version": 3,
  "name": "Criceto virtuale",
  "version": "1.0",
  "description": "Un criceto animato che insegue il cursore su ogni pagina web.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hamster.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "criceto-virtuale@example.com",
      "strict_min_version": "115.0"
    }
  }
}
